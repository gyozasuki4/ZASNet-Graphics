[Unit]
Description=ZASNet live NEXRAD Level III radar acquisition
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zasbroadcast
Group=zasbroadcast
WorkingDirectory=/opt/zasnet-broadcast
EnvironmentFile=-/opt/zasnet-broadcast/config/backend.env
ExecStart=/opt/zasnet-broadcast/venv/bin/python /opt/zasnet-broadcast/scripts/live_radar_worker.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zasnet-broadcast/data /opt/zasnet-broadcast/logs

[Install]
WantedBy=multi-user.target
